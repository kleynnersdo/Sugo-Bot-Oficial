<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Panel de Control - LatinBot"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="40dp"/>

    <Button
        android:id="@+id/btn_notificaciones"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="1. Permiso de Notificaciones"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btn_accesibilidad"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="2. Permiso de Accesibilidad"
        android:layout_marginBottom="40dp"/>

    <Switch
        android:id="@+id/switch_estado_bot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Estado del Bot: "
        android:textSize="20sp"
        android:textStyle="bold"/>

</LinearLayout>