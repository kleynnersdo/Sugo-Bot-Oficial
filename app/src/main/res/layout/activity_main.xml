<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="#F5F5F5">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Panel de Control - LatinBot IA"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="40dp"
        android:textColor="#333333"/>

    <Button
        android:id="@+id/btn_notificaciones"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="1. Activar Notificaciones"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#2196F3"/>

    <Button
        android:id="@+id/btn_accesibilidad"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="2. Activar Accesibilidad"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#4CAF50"/>

    <Button
        android:id="@+id/btn_bateria"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="3. Optimización de Batería (No Dormir)"
        android:layout_marginBottom="40dp"
        android:backgroundTint="#FF9800"/>

    <Switch
        android:id="@+id/switch_estado_bot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Estado del Bot: "
        android:textSize="18sp"
        android:textStyle="bold"/>

</LinearLayout>